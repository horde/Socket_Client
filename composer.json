{
    "name": "horde/socket_client",
    "description": "Network socket client library",
    "type": "library",
    "homepage": "https://www.horde.org",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Ralf Lang",
            "email": "ralf.lang@ralf-lang.de",
            "role": "maintainer"
        },
        {
            "name": "Michael Slusarz",
            "email": "slusarz@horde.org",
            "role": "lead"
        }
    ],
    "keywords": [
        "network",
        "raw",
        "communication"
    ],
    "time": "2026-04-15",
    "repositories": [],
    "require": {
        "php": "^8.1",
        "horde/exception": "^3 || dev-FRAMEWORK_6_0"
    },
    "require-dev": {},
    "suggest": {
        "ext-openssl": "*",
        "psr/event-dispatcher": "^1",
        "horde/eventdispatcher": "^1 || dev-FRAMEWORK_6_0"
    },
    "autoload": {
        "classmap": [
            "lib/"
        ],
        "psr-4": {
            "Horde\\Socket\\Client\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Socket\\Client\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "3.x-dev"
        }
    }
}